# See https://git-scm.com/docs/gitattributes for more about git attribute files.

# Mark the database schema as having been generated.
db/schema.rb linguist-generated

# Mark generated design system CSS (built from tokens/sure.tokens.json).
app/assets/tailwind/sure-design-system/_generated.css linguist-generated

# Mark any vendored files as having been vendored.
vendor/* linguist-vendored
config/credentials/*.yml.enc diff=rails_credentials
config/credentials.yml.enc diff=rails_credentials

# Ensure consistent line endings for scripts and Ruby files to avoid shebang issues on Windows
bin/* text eol=lf
*.sh text eol=lf
*.rb text eol=lf
.devcontainer/.bashrc text eol=lf

# Generator templates are Ruby source written out verbatim; CRLF here becomes
# CRLF in every generated file and fails the scaffold tests on Windows.
*.tt text eol=lf

# Binaries must never be line-ending converted. Without these, Git's autocrlf
# rewrites the bytes of test PDFs on checkout, their internal xref offsets stop
# pointing at the right place, and the failure reads as a malformed PDF.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.xlsx binary
*.docx binary
*.zip binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary
