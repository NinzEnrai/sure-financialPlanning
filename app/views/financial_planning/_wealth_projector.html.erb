<%# locals: (projector:) %>
<%# 10-year net worth projection. Every point is modelled, so the line is
    dashed throughout and the opening balance is drawn as a fact.

    The sliders are an explorer, not an editor: they re-project through the
    `projection` endpoint without persisting anything. The monthly contribution
    itself comes from the Savings Rate card. %>
<%= render DS::Card.new do %>
  <div class="flex items-center justify-between gap-3">
    <h2 class="text-lg font-medium text-primary"><%= t(".title") %></h2>
    <%= icon "trending-up", size: "sm", color: "success" %>
  </div>

  <p class="text-sm text-secondary mt-1"><%= t(".subtitle") %></p>

  <% points = projector.points %>
  <% if points.size < 2 %>
    <div class="h-52 flex items-center justify-center">
      <p class="text-secondary text-sm"><%= t(".no_data") %></p>
    </div>
  <% else %>
    <% suggested = projector.monthly_contribution.to_f %>
    <% max_contribution = [ (suggested.abs * 3).ceil, 100_000 ].max %>
    <% step = [ (suggested.abs / 20).round, 100 ].max %>
    <% currency = Current.family.currency %>

    <div class="mt-4 space-y-3"
      data-controller="compound-calculator"
      data-compound-calculator-url-value="<%= projection_financial_planning_path %>"
      data-compound-calculator-currency-value="<%= currency %>"
      data-compound-calculator-contribution-step-value="<%= step %>"
      data-compound-calculator-contribution-max-value="<%= max_contribution %>"
      data-compound-calculator-growth-max-value="25">
      <div>
        <div class="flex items-baseline justify-between gap-2">
          <label for="calc-contribution" class="text-xs text-secondary"><%= t(".monthly_investment") %></label>
          <span class="text-xs font-medium text-primary tabular-nums"
            data-compound-calculator-target="contributionValue"><%= format_money(projector.monthly_contribution_money(currency), precision: 0) %></span>
        </div>
        <input type="range" id="calc-contribution"
          class="w-full mt-1"
          min="0"
          max="<%= max_contribution %>"
          step="<%= step %>"
          value="<%= suggested.round %>"
          data-compound-calculator-target="contribution"
          autocomplete="off"
          aria-describedby="calc-contribution-hint">
        <p id="calc-contribution-hint" class="text-xs text-subdued mt-1"><%= t(".monthly_investment_hint") %></p>
      </div>

      <div>
        <div class="flex items-baseline justify-between gap-2">
          <label for="calc-growth" class="text-xs text-secondary"><%= t(".annual_growth") %></label>
          <span class="text-xs font-medium text-primary tabular-nums"
            data-compound-calculator-target="growthValue"><%= number_to_percentage(projector.growth_rate_pct, precision: 1) %></span>
        </div>
        <input type="range" id="calc-growth"
          class="w-full mt-1"
          min="0"
          max="25"
          step="0.5"
          value="<%= projector.growth_rate_pct %>"
          data-compound-calculator-target="growth"
          autocomplete="off">
      </div>

      <div class="flex items-baseline justify-between gap-2 pt-2 border-t border-subdued">
        <p class="text-xs text-secondary"><%= t(".projected_balance") %></p>
        <p class="text-lg font-semibold text-primary tabular-nums privacy-sensitive"
          data-compound-calculator-target="outcome"><%= format_money(projector.final_balance_money(currency), precision: 0) %></p>
      </div>

      <p class="text-xs text-subdued"><%= t(".slider_hint") %></p>

      <div class="w-full h-64 privacy-sensitive"
        data-controller="wealth-projection-chart"
        data-compound-calculator-target="chart"
        data-wealth-projection-chart-aria-label-value="<%= t(".chart_aria") %>"
        data-wealth-projection-chart-year-prefix-value="<%= t(".year_prefix") %>"
        data-wealth-projection-chart-number-format-value="<%= Current.family&.number_format || "western" %>"
        data-wealth-projection-chart-data-value="<%= {
          currency: currency,
          currency_symbol: Money.new(0, currency).currency.symbol,
          description: t(".chart_description"),
          points: points.map { |point|
            {
              date: point.date.to_s,
              year: point.year,
              balance: point.balance.to_f,
              balance_formatted: format_money(point.balance_money(currency)),
              balance_label: format_money(point.balance_money(currency))
            }
          }
        }.to_json %>">
      </div>
    </div>
  <% end %>

  <div class="mt-4 pt-3 border-t border-subdued grid grid-cols-1 @md:grid-cols-3 gap-3">
    <div>
      <p class="text-xs text-secondary"><%= t(".today") %></p>
      <p class="text-sm font-medium text-primary tabular-nums privacy-sensitive">
        <%= format_money(projector.opening_balance && Money.new(projector.opening_balance, Current.family.currency), precision: 0) %>
      </p>
    </div>

    <div>
      <p class="text-xs text-secondary"><%= t(".savings_rate") %></p>
      <p class="text-sm font-medium text-primary tabular-nums">
        <% if projector.savings_rate_percent.nil? %>
          <span class="text-subdued"><%= t(".unavailable") %></span>
        <% else %>
          <%= number_to_percentage(projector.savings_rate_percent, precision: 1) %>
        <% end %>
      </p>
    </div>

    <div>
      <p class="text-xs text-secondary"><%= t(".growth_rate") %></p>
      <p class="text-sm font-medium text-primary tabular-nums">
        <%= number_to_percentage(projector.growth_rate_pct, precision: 1) %>
      </p>
    </div>
  </div>

  <p class="text-xs text-subdued mt-3"><%= t(".assumptions") %></p>
<% end %>
