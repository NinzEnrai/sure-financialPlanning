<%# locals: (fire:, setting:) %>
<%# FIRE progress: current net worth against the target implied by the family's
    configured withdrawal rate (25x at 4%), derived from average annual expenses
    over the trailing year.

    The assumptions form posts to update_setting, which has existed since the
    widget was built -- this card is the first place the two rates are actually
    editable. Withdraw out of range and nothing is sent, so a partial drag can
    never persist a rate that would make the target nonsense. %>
<%= render DS::Card.new do %>
  <div class="flex items-center justify-between gap-3">
    <h2 class="text-lg font-medium text-primary"><%= t(".title") %></h2>
    <div class="flex items-center gap-2">
      <%= render DS::Pill.new(label: t(".variants.#{setting.fire_variant}"), tone: :warning, size: :sm) %>
      <%= icon "flame", size: "sm", color: "warning" %>
    </div>
  </div>

  <div class="mt-4 space-y-1">
    <p class="text-xs text-secondary"><%= t(".net_worth") %></p>
    <p class="text-3xl font-medium text-primary tabular-nums privacy-sensitive">
      <%= format_money(fire.current_net_worth_money) %>
    </p>
  </div>

  <div class="mt-4">
    <%= render DS::ProgressBar.new(
          percent: fire.bar_percent,
          tone: fire.achieved? ? :success : :warning,
          label: t(".bar_label")
        ) %>
  </div>

  <div class="mt-2 flex items-center justify-between gap-3">
    <p class="text-xs text-secondary tabular-nums">
      <% if fire.percent.nil? %>
        <%= t(".unavailable") %>
      <% else %>
        <%= t(".progress", percent: number_to_percentage(fire.percent, precision: 1)) %>
      <% end %>
    </p>
    <%# Suppressed for Coast FIRE, where the date matters more than the countdown. %>
    <% if fire.months_to_target && !fire.coast_fire? %>
      <%= render DS::Pill.new(label: t(".eta", years: (fire.months_to_target / 12.0).ceil),
                             tone: :info, size: :sm, marker: false) %>
    <% end %>
  </div>

  <div class="mt-4 pt-3 border-t border-subdued space-y-2">
    <%= render DS::DetailRow.new(label: t(".annual_expenses")) do %>
      <span class="privacy-sensitive"><%= format_money(fire.average_annual_expenses_money, precision: 0) %></span>
    <% end %>

    <%= render DS::DetailRow.new(label: t(".target")) do %>
      <span class="privacy-sensitive"><%= format_money(fire.target_money, precision: 0) %></span>
    <% end %>

    <%= render DS::DetailRow.new(label: t(".rule")) do %>
      <span class="tabular-nums"><%= t(".rule_value", multiple: fire.multiple, rate: number_to_percentage(fire.withdrawal_rate_pct, precision: 1)) %></span>
    <% end %>

    <% unless fire.achieved? %>
      <%= render DS::DetailRow.new(label: t(".remaining")) do %>
        <span class="privacy-sensitive"><%= format_money(fire.remaining_money, precision: 0) %></span>
      <% end %>
    <% end %>

    <%# Coast FIRE asks a different question: not "when" but "will it be there
        by the age I picked". So the ETA pill is replaced by the projection at
        that date, and the answer can honestly be "no". %>
    <% if fire.coast_fire? %>
      <%= render DS::DetailRow.new(label: t(".coast_target_date", year: fire.target_year)) do %>
        <% if fire.months_until_target_date.nil? %>
          <span class="text-subdued"><%= t(".coast_date_passed") %></span>
        <% elsif fire.projected_balance_at_target_date_money %>
          <span class="privacy-sensitive"><%= format_money(fire.projected_balance_at_target_date_money, precision: 0) %></span>
        <% else %>
          <span class="text-subdued"><%= t(".unavailable") %></span>
        <% end %>
      <% end %>

      <% if fire.coast_on_track? == false %>
        <p class="text-xs text-destructive"><%= t(".coast_behind") %></p>
      <% end %>
    <% end %>
  </div>

  <%= render DS::Disclosure.new(variant: :card_inset, class: "mt-4") do |disclosure| %>
    <% disclosure.with_summary_content do %>
      <div class="flex items-center gap-2">
        <%= icon "settings", size: "sm", color: "secondary" %>
        <p class="text-sm font-medium text-primary"><%= t(".assumptions_title") %></p>
      </div>
    <% end %>

    <%= styled_form_with model: setting,
                         url: setting_financial_planning_path,
                         method: :patch,
                         scope: :planning_setting,
                         class: "mt-3 space-y-3",
                         data: { controller: "fire-variant",
                                 "fire-variant-coast-value": "coast" } do |form| %>
      <%# Variant first, because it decides both what the rest of the form means
          and what rate the withdrawal field starts from. %>
      <%= form.select :fire_variant,
          options_for_select(
            PlanningSetting::FIRE_VARIANTS.keys.map { |key| [ t(".variants.#{key}"), key ] },
            setting.fire_variant
          ),
          {},
          label: t(".variant_label"),
          data: { fire_variant_target: "select" } %>

      <p class="text-xs text-subdued -mt-1"><%= t(".variants.#{setting.fire_variant}_body") %></p>

      <div data-fire-variant-target="ageField" <%= "hidden" unless setting.coast_fire? %>>
        <%= form.text_field :fire_target_year,
                            label: t(".target_year_label"),
                            type: "number",
                            step: "1",
                            min: Date.current.year,
                            max: Date.current.year + 60,
                            value: setting.fire_target_year %>
      </div>

      <%= form.text_field :fire_withdrawal_rate_pct,
                          label: t(".withdrawal_label"),
                          type: "number",
                          step: "0.1",
                          min: "0.1",
                          max: "20",
                          value: setting.fire_withdrawal_rate_pct.to_f %>

      <%= form.text_field :annual_growth_rate_pct,
                          label: t(".growth_label"),
                          type: "number",
                          step: "0.1",
                          min: "0.1",
                          max: "50",
                          value: setting.annual_growth_rate_pct.to_f %>

      <div class="flex justify-end">
        <%= form.submit(t(".save")) %>
      </div>
    <% end %>

    <p class="text-xs text-subdued mt-2"><%= t(".assumptions_hint") %></p>
  <% end %>
<% end %>