<%# Financial planning (Wealth): read-only projections plus editable inputs,
    laid out as cards. Widgets can be hidden/restored the same way as the
    dashboard, through the edit button in the header. %>
<div class="@container space-y-6 pb-6 lg:pb-12">
  <header>
    <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-2xl font-semibold text-primary"><%= t(".title") %></h1>
          <%= render DS::Pill.new(label: t("shared.preview"), size: :md) %>
        </div>
        <p class="text-sm text-secondary mt-1"><%= t(".subtitle") %></p>
        <div class="mt-2">
          <%= render DS::Link.new(text: t(".review_link"), href: review_financial_planning_path) %>
        </div>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <% if @customizing_planning %>
          <%= render DS::Link.new(
                variant: "outline",
                icon: "check",
                text: t("financial_planning.customize.done"),
                href: financial_planning_path
              ) %>
        <% else %>
          <%= render DS::Link.new(
                variant: "outline",
                icon: "layout-grid",
                text: t("financial_planning.customize.start"),
                href: financial_planning_path(customize: true),
                aria: { label: t("financial_planning.customize.start") }
              ) %>
        <% end %>
      </div>
    </div>
  </header>

  <% section_visible = ->(key) { !@planning_hidden_sections.include?(key) && (key != "tax_profile" || Current.user.admin?) } %>
  <% known_hidden = @planning_hidden_sections.select { |key| @planning_sections.key?(key) && (key != "tax_profile" || Current.user.admin?) } %>
  <% visible_section_keys = @planning_rows.reject { |row| row == :period_picker }.flatten.select { |key| section_visible.call(key) } %>

  <% if @customizing_planning %>
    <%= render DS::Card.new(class: "gap-3") do %>
      <div class="space-y-1">
        <h2 class="text-base font-medium text-primary"><%= t("financial_planning.customize.hidden_title") %></h2>
        <p class="text-sm text-secondary">
          <%= known_hidden.any? ? t("financial_planning.customize.hidden_description") : t("financial_planning.customize.none_hidden") %>
        </p>
      </div>

      <% if known_hidden.any? %>
        <div class="flex flex-wrap gap-2">
          <% known_hidden.each do |key| %>
            <% section = @planning_sections.fetch(key) %>
            <%= render DS::Button.new(
                  variant: "outline",
                  size: "sm",
                  icon: "plus",
                  text: t(section[:title]),
                  href: section_hidden_financial_planning_path(key),
                  method: :patch,
                  params: { hidden: false }
                ) %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if visible_section_keys.empty? && !@customizing_planning %>
    <%= render DS::Card.new do %>
      <%= render DS::EmptyState.new(
            icon: "layout-grid",
            title: t("financial_planning.customize.all_hidden_title"),
            description: t("financial_planning.customize.all_hidden_description")
          ) do |empty_state| %>
        <% empty_state.with_action do %>
          <%= render DS::Link.new(
                variant: "outline",
                icon: "layout-grid",
                text: t("financial_planning.customize.start"),
                href: financial_planning_path(customize: true)
              ) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% @planning_rows.each do |row| %>
    <% if row == :period_picker %>
      <% next if visible_section_keys.empty? %>
      <div class="flex justify-end">
        <%= render UI::PeriodPicker.new(selected: @period, url: financial_planning_path) %>
      </div>
      <% next %>
    <% end %>

    <% keys = row.select { |key| section_visible.call(key) } %>
    <% next if keys.empty? %>

    <div class="grid grid-cols-1 @3xl:grid-cols-2 gap-4 items-stretch">
      <% keys.each do |key| %>
        <% section = @planning_sections.fetch(key) %>
        <%= render "financial_planning/section",
                   key: key,
                   title: section[:title],
                   partial: section[:partial],
                   locals: @planning_locals.fetch(key),
                   span_full: keys.size == 1 %>
      <% end %>
    </div>
  <% end %>
</div>
