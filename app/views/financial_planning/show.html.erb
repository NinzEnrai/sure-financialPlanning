<%# Financial Planning: four read-only projections derived from the family's
    existing ledger. Header + card grid follows the Plan hub's shape. %>
<div class="@container space-y-6 pb-6 lg:pb-12">
  <header>
    <div class="flex items-center gap-2">
      <h1 class="text-2xl font-semibold text-primary"><%= t(".title") %></h1>
      <%= render DS::Pill.new(label: t("shared.preview"), size: :md) %>
    </div>
    <p class="text-sm text-secondary mt-1"><%= t(".subtitle") %></p>
    <div class="mt-2">
      <%= render DS::Link.new(text: t(".review_link"), href: review_financial_planning_path) %>
    </div>
  </header>

  <%# The advisory summary sits above the individual figures: it is the answer
      to "where should we look first", which is what a planner opens with. %>
  <%= render "financial_planning/health_scorecard", scorecard: @health_scorecard %>

  <%# Who the plan is for, before any of the figures that depend on it. %>
  <%= render "financial_planning/household", members: @household_members, member: @household_member %>

  <%# What the plan would leave behind if income stopped. %>
  <%= render "financial_planning/protection",
             policies: @insurance_policies,
             policy: @insurance_policy,
             gap: @protection_gap,
             members: @household_members %>

  <%# The FIRE card edits the family's saved assumptions, so it needs the
      PlanningSetting record rather than deriving them again. %>
  <div class="grid grid-cols-1 @3xl:grid-cols-2 gap-4 items-stretch">
    <%= render "financial_planning/savings_rate", rate: @savings_rate,
                                                 year_to_date: @year_to_date_savings_rate %>
    <%= render "financial_planning/fire_progress", fire: @fire_progress,
                                                  setting: @planning_setting %>
  </div>

  <%# The two questions that come before "how much am I saving": how long could
      we last without income, and what is the debt costing us? %>
  <div class="grid grid-cols-1 @3xl:grid-cols-2 gap-4 items-stretch">
    <%= render "financial_planning/emergency_fund", emergency_fund: @emergency_fund, setting: @planning_setting %>
    <%= render "financial_planning/debt_summary", debt: @debt_summary %>
  </div>

  <%# What the money earned, and whether the goals can all be funded at once. %>
  <div class="grid grid-cols-1 @3xl:grid-cols-2 gap-4 items-stretch">
    <%= render "financial_planning/portfolio_return", portfolio: @portfolio_return %>
    <%= render "financial_planning/goal_funding", funding: @goal_funding %>
  </div>

  <%# Where the invested money sits, and whether one position dominates. %>
  <%= render "financial_planning/allocation", allocation: @portfolio_allocation, setting: @planning_setting %>

  <%# Will the cash last until payday? Trailing averages, not a bill calendar.
      Beside it, the coaching observations that follow from those same figures. %>
  <div class="grid grid-cols-1 @3xl:grid-cols-2 gap-4 items-stretch">
    <%= render "financial_planning/cash_flow_forecast", forecast: @cash_flow_forecast %>
    <%= render "financial_planning/coaching", coaching: @coaching %>
  </div>

  <%# The diagnostics: what is missing behind the figures, and what tax work
      can actually be supported by the data. %>
  <div class="grid grid-cols-1 @3xl:grid-cols-2 gap-4 items-stretch">
    <%= render "financial_planning/data_confidence", confidence: @data_confidence %>
    <%= render "financial_planning/tax_readiness", readiness: @tax_readiness, accounts: @tradebook_accounts %>
  </div>

  <%# What was actually sold this year, from FIFO lots. Estimate only. %>
  <%= render "financial_planning/realised_gains", gains: @realised_gains %>

  <%# Per-person taxable gains after set-off and the long-term exemption. %>
  <%= render "financial_planning/capital_gains_estimate", estimate: @capital_gains %>

  <%# Losses available to book, with the costs of selling stated. %>
  <%= render "financial_planning/tax_harvesting", harvesting: @tax_harvesting %>

  <%# Only the analyzer follows @period; savings rate, FIRE and the projection
      are anchored to today / trailing windows. %>
  <div class="flex justify-end">
    <%= render UI::PeriodPicker.new(selected: @period, url: financial_planning_path) %>
  </div>

  <%= render "financial_planning/budget_analyzer", analyzer: @budget_analyzer, period: @period %>

  <%= render "financial_planning/wealth_projector", projector: @projector %>

  <%# The plan against market paths, not just one line. %>
  <%= render "financial_planning/retirement_stress", stress: @retirement_stress, setting: @planning_setting %>
</div>
