<%# Financial Planning: four read-only projections derived from the family's
    existing ledger. Header + card grid follows the Plan hub's shape. %>
<div class="@container space-y-6 pb-6 lg:pb-12">
  <header>
    <div class="flex items-center gap-2">
      <h1 class="text-2xl font-semibold text-primary"><%= t(".title") %></h1>
      <%= render DS::Pill.new(label: t("shared.preview"), size: :md) %>
    </div>
    <p class="text-sm text-secondary mt-1"><%= t(".subtitle") %></p>
  </header>

  <%# The advisory summary sits above the individual figures: it is the answer
      to "where should we look first", which is what a planner opens with. %>
  <%= render "financial_planning/health_scorecard", scorecard: @health_scorecard %>

  <%# The FIRE card edits the family's saved assumptions, so it needs the
      PlanningSetting record rather than deriving them again. %>
  <div class="grid grid-cols-1 @3xl:grid-cols-2 gap-4 items-stretch">
    <%= render "financial_planning/savings_rate", rate: @savings_rate,
                                                 year_to_date: @year_to_date_savings_rate %>
    <%= render "financial_planning/fire_progress", fire: @fire_progress,
                                                  setting: @planning_setting %>
  </div>

  <%# The two questions that come before "how much am I saving": how long could
      we last without income, and what is the debt costing us? %>
  <div class="grid grid-cols-1 @3xl:grid-cols-2 gap-4 items-stretch">
    <%= render "financial_planning/emergency_fund", emergency_fund: @emergency_fund %>
    <%= render "financial_planning/debt_summary", debt: @debt_summary %>
  </div>

  <%# What the money earned, and whether the goals can all be funded at once. %>
  <div class="grid grid-cols-1 @3xl:grid-cols-2 gap-4 items-stretch">
    <%= render "financial_planning/portfolio_return", portfolio: @portfolio_return %>
    <%= render "financial_planning/goal_funding", funding: @goal_funding %>
  </div>

  <%# Only the analyzer follows @period; savings rate, FIRE and the projection
      are anchored to today / trailing windows. %>
  <div class="flex justify-end">
    <%= render UI::PeriodPicker.new(selected: @period, url: financial_planning_path) %>
  </div>

  <%= render "financial_planning/budget_analyzer", analyzer: @budget_analyzer, period: @period %>

  <%= render "financial_planning/wealth_projector", projector: @projector %>
</div>
