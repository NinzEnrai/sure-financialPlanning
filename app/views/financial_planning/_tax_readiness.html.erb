<%# locals: (readiness:, accounts:) %>
<%# A pre-flight check for capital-gains work, not a tax calculation. It lists
    the inputs a CA would ask for and marks what is missing; no rate or figure
    is computed here, by design. %>
<% status_styles = {
     good:      { icon: "circle-check", color: "success" },
     watch:     { icon: "triangle-alert", color: "warning" },
     attention: { icon: "circle-alert", color: "destructive" }
   } %>
<%= render DS::Card.new(data: { testid: "tax-readiness" }, class: "gap-4") do %>
  <div class="flex items-center justify-between gap-3">
    <h2 class="text-lg font-medium text-primary"><%= t(".title") %></h2>
    <%= icon "receipt-text", size: "sm", color: "info" %>
  </div>

  <p class="text-xs text-secondary">
    <%= t(".period", label: readiness.financial_year_label) %>
  </p>

  <ul class="divide-y divide-subdued">
    <% readiness.checks.each do |check| %>
      <% style = status_styles.fetch(check.status) %>
      <li class="py-2.5 flex items-start gap-2" data-check="<%= check.key %>" data-status="<%= check.status %>">
        <%= icon style[:icon], size: "sm", color: style[:color], class: "mt-0.5" %>
        <div class="min-w-0 flex-1">
          <p class="text-sm text-primary"><%= t(".checks.#{check.key}.label") %></p>
          <p class="text-xs text-secondary mt-0.5 tabular-nums">
            <%= t(".checks.#{check.key}.detail", count: check.count, total: check.total) %>
          </p>
        </div>
      </li>
    <% end %>
  </ul>

  <p class="text-xs text-subdued"><%= t(".note") %></p>

  <div class="mt-2 pt-3 border-t border-subdued space-y-2">
    <p class="text-xs text-secondary"><%= t(".tradebook_title") %></p>
    <p class="text-xs text-subdued"><%= t(".tradebook_hint") %></p>

    <% if accounts.any? %>
      <%= styled_form_with url: import_tradebook_financial_planning_path,
                           method: :post,
                           multipart: true,
                           class: "grid grid-cols-1 @md:grid-cols-2 gap-2" do |form| %>
        <%= form.select :account_id,
            options_for_select(accounts.map { |account| [ account.name, account.id ] }),
            { include_blank: t(".tradebook_choose_account") },
            label: t(".tradebook_account") %>
        <%= form.file_field :tradebook, label: t(".tradebook_file"), accept: ".csv,text/csv" %>
        <div class="flex justify-end @md:col-span-2">
          <%= form.submit t(".tradebook_import") %>
        </div>
      <% end %>
      <p class="text-xs text-subdued"><%= t(".tradebook_note") %></p>
    <% else %>
      <p class="text-xs text-secondary"><%= t(".tradebook_no_accounts") %></p>
    <% end %>
  </div>
<% end %>
