<%# locals: (analyzer:, period:) %>
<%# 50/30/20 split of the selected period's spending. Each bucket is scored
    against its target share of net income — needs and wants as ceilings,
    savings as a floor. The donut makes the shape of the month legible at a
    glance; the bucket list below it is the legend. %>
<%= render DS::Card.new do %>
  <div class="flex items-center justify-between gap-3">
    <h2 class="text-lg font-medium text-primary"><%= t(".title") %></h2>
    <%= icon "scale", size: "sm", color: "default" %>
  </div>

  <p class="text-sm text-secondary mt-1"><%= period.comparison_label %></p>

  <%# Donut segments: one per bucket that actually spent, plus an unallocated
      slice for anything that did not fit a bucket. The donut-chart controller
      handles hover, highlighting and the centre total. %>
  <% donut_segments = analyzer.buckets.map do |bucket|
       tone = bucket.key == "needs" ? "info" : (bucket.key == "wants" ? "warning" : "success")
       {
         id: bucket.key,
         name: t("planning_setting.buckets.#{bucket.key}"),
         amount: bucket.amount.to_f,
         color: "var(--color-#{tone == "info" ? "blue-600" : (tone == "warning" ? "yellow-600" : "green-700")})",
         percentage: bucket.share_pct
       }
     end %>
  <% unassigned = analyzer.unassigned_categories %>
  <% if unassigned.any? %>
    <% donut_segments << {
         id: "unassigned",
         name: t(".unassigned_title"),
         amount: unassigned.sum { |e| e[:total].to_f },
         color: "var(--color-gray-400)",
         percentage: nil
       } %>
  <% end %>
  <%# A budget with nothing spent still needs a shape, otherwise the donut
      renders as an empty ring and looks broken. %>
  <% if donut_segments.all? { |s| s[:amount].zero? } %>
    <% donut_segments = [ { id: "empty", name: t(".unavailable"), amount: 1, color: "var(--color-gray-200)", percentage: nil } ] %>
  <% end %>

  <div class="mt-4 flex flex-col @md:flex-row gap-6 items-center">
    <div class="w-40 h-40 shrink-0 relative"
      data-controller="donut-chart"
      data-donut-chart-segments-value="<%= donut_segments.to_json %>"
      data-donut-chart-segment-opacity-value="0.9"
      data-donut-chart-extended-hover-value="true"
      data-donut-chart-hover-extension-value="2">
      <div data-donut-chart-target="chartContainer" class="absolute inset-0 pointer-events-none"></div>

      <div data-donut-chart-target="contentContainer" class="flex justify-center items-center h-full">
        <div data-donut-chart-target="defaultContent" class="flex flex-col items-center">
          <p class="text-xs text-secondary"><%= t(".net_income") %></p>
          <p class="text-lg font-medium text-primary tabular-nums privacy-sensitive">
            <%= format_money(analyzer.income_money) %>
          </p>
        </div>

        <% donut_segments.each do |segment| %>
          <div id="segment_<%= segment[:id] %>" class="hidden">
            <div class="flex flex-col gap-2 items-center">
              <p class="text-sm text-secondary"><%= segment[:name] %></p>
              <p data-donut-chart-target="amount" class="text-xl font-medium text-primary privacy-sensitive whitespace-nowrap">
                <%= format_money(Money.new(segment[:amount], Current.family.currency), precision: 0) %>
              </p>
              <% if segment[:percentage] %>
                <p class="text-xs text-secondary privacy-sensitive"><%= number_to_percentage(segment[:percentage], precision: 1) %></p>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <%# Legend + bucket detail %>
    <div class="flex-1 min-w-0 divide-y divide-subdued w-full">
      <% analyzer.buckets.each do |bucket| %>
        <% tone = bucket.key == "needs" ? :info : (bucket.key == "wants" ? :warning : :success) %>
        <div class="py-3 flex items-center justify-between gap-3">
          <div class="min-w-0 flex items-center gap-2">
            <span class="inline-block w-2.5 h-2.5 rounded-full shrink-0"
                  style="background-color: var(--color-<%= tone == :info ? "blue-600" : (tone == :warning ? "yellow-600" : "green-700") %>)"></span>
            <div class="min-w-0">
              <p class="text-sm font-medium text-primary"><%= t("planning_setting.buckets.#{bucket.key}") %></p>
              <p class="text-xs text-secondary tabular-nums privacy-sensitive">
                <%= t(".target_of", target: number_to_percentage(bucket.target_share_pct, precision: 0)) %>
              </p>
            </div>
          </div>

          <div class="text-right shrink-0">
            <p class="text-sm font-medium text-primary tabular-nums privacy-sensitive">
              <%= format_money(bucket.amount_money) %>
            </p>
            <% if bucket.share_pct.nil? %>
              <p class="text-xs text-subdued"><%= t(".unavailable") %></p>
            <% else %>
              <p class="text-xs tabular-nums <%= bucket.on_track? ? "text-success" : "text-destructive" %>">
                <%= number_to_percentage(bucket.share_pct, precision: 1) %>
              </p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mt-2 pt-3 border-t border-subdued flex items-center justify-between gap-3">
    <p class="text-sm text-secondary"><%= t(".net_income") %></p>
    <p class="text-sm font-medium text-primary tabular-nums privacy-sensitive">
      <%= format_money(analyzer.income_money) %>
    </p>
  </div>

  <% unassigned = analyzer.unassigned_categories %>
  <% if unassigned.any? %>
    <%= render DS::Note.new(title: t(".unassigned_title")) do %>
      <%= t(".unassigned_body",
             count: unassigned.size,
             amount: format_money(Money.new(unassigned.sum { |e| e[:total].to_f }, Current.family.currency))) %>
    <% end %>
  <% end %>

  <%= render "financial_planning/bucket_picker",
             analyzer: analyzer,
             setting: Current.family.planning_setting || Current.family.build_planning_setting %>
<% end %>