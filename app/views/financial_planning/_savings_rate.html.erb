<%# locals: (rate:, year_to_date:) %>
<%# Cash savings rate for the current month and for the year to date, both from
    the same IncomeStatement scoping so they compare directly.

    Contributions into investments are held apart from spending: the headline is
    cash only, and the "incl. investments" line below it shows what was actually
    kept once investing is counted. Every figure on a tile comes from one
    SavingsRate instance, so they can't disagree with each other. %>
<%= render DS::Card.new do %>
  <div class="flex items-center justify-between gap-3">
    <h2 class="text-lg font-medium text-primary"><%= t(".title") %></h2>
    <%= icon "piggy-bank", size: "sm", color: "success" %>
  </div>

  <div class="mt-4 grid grid-cols-1 @md:grid-cols-2 gap-4">
    <% [ [ t(".this_month"), rate ], [ t(".year_to_date"), year_to_date ] ].each do |label, figure| %>
      <div class="bg-container-inset rounded-lg p-3 space-y-1">
        <p class="text-xs text-secondary"><%= label %></p>
        <p class="text-3xl font-medium text-primary tabular-nums privacy-sensitive">
          <% if figure.percent.nil? %>
            <span class="text-lg text-subdued"><%= t(".unavailable") %></span>
          <% else %>
            <%= number_to_percentage(figure.percent, precision: 1) %>
          <% end %>
        </p>
        <p class="text-xs text-secondary tabular-nums privacy-sensitive">
          <%= t(".savings_of", amount: format_money(figure.cash_savings_money)) %>
        </p>

        <% if figure.invested.positive? %>
          <div class="pt-1 mt-1 border-t border-subdued space-y-1">
            <p class="text-xs text-secondary tabular-nums privacy-sensitive">
              <%= t(".invested_of", amount: format_money(figure.invested_money)) %>
            </p>
            <p class="text-xs text-secondary tabular-nums privacy-sensitive">
              <% if figure.total_percent.nil? %>
                <%= t(".total_saved_amount", amount: format_money(figure.savings_money)) %>
              <% else %>
                <%= t(".total_saved", percent: number_to_percentage(figure.total_percent, precision: 1), amount: format_money(figure.savings_money)) %>
              <% end %>
            </p>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Twelve months of both rates on one axis. The dashed line never sits below
      the solid one -- investing is a way of saving -- so the vertical gap between
      them is that month's investing made visible. %>
  <% monthly = rate.monthly_series(months: 12) %>
  <% if monthly.size >= 2 %>
    <div class="w-full h-56 mt-4 privacy-sensitive"
      data-controller="savings-rate-chart"
      data-savings-rate-chart-aria-label-value="<%= t(".chart_aria") %>"
      data-savings-rate-chart-month-format-value="<%= t(".chart_month") %>"
      data-savings-rate-chart-solid-label-value="<%= t(".chart_solid") %>"
      data-savings-rate-chart-dashed-label-value="<%= t(".chart_dashed") %>"
      data-savings-rate-chart-data-value="<%= {
        currency: Current.family.currency,
        description: t(".chart_description"),
        series: monthly.map { |row|
          {
            date: row[:date].to_s,
            tooltip_date: l(row[:date], format: "%B %Y"),
            # to_f, not the raw value: a BigDecimal rides through #to_json as a
            # *string*, and the chart then does d3.max over strings, which
            # compares lexicographically and makes the subtraction NaN -- the
            # whole plot silently disappears while the legend still draws.
            percent: row[:percent]&.to_f,
            total_percent: row[:total_percent]&.to_f,
            cash_label: format_money(Money.new(row[:cash_savings], Current.family.currency), precision: 0),
            total_label: format_money(Money.new(row[:savings], Current.family.currency), precision: 0)
          }
        }
      }.to_json %>">
    </div>
    <p class="text-xs text-subdued mt-2"><%= t(".chart_note") %></p>
  <% end %>

  <% if rate.income.positive? %>
    <div class="mt-4">
      <%= render DS::ProgressBar.new(
            percent: rate.percent,
            tone: rate.percent >= 20 ? :success : :warning,
            label: t(".bar_label", label: t(".this_month"))
          ) %>
    </div>

    <p class="text-xs text-subdued mt-2"><%= t(".target_hint") %></p>
  <% else %>
    <div class="mt-4">
      <%= render DS::ProgressBar.new(percent: nil, tone: :neutral) %>
      <p class="text-xs text-subdued mt-2"><%= t(".no_income") %></p>
    </div>
  <% end %>
<% end %>
